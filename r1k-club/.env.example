# ---------------------------------------------------------------------------
# Frontend (Vite) — tudo aqui vai para o bundle. Nunca coloque segredos.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_SITE_URL=https://r1kclub.com

# Opcional — sem a chave o app funciona e os eventos so aparecem no console.
VITE_POSTHOG_KEY=phc_xxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Edge Functions (Supabase) — definidos com `supabase secrets set`, NUNCA aqui.
# Listados apenas como referencia do que precisa existir.
# ---------------------------------------------------------------------------
# SUPABASE_URL                — injetado automaticamente pelo Supabase
# SUPABASE_SERVICE_ROLE_KEY   — injetado automaticamente pelo Supabase
#
# Mercado Pago (Suas integracoes > sua aplicacao > Credenciais):
#   Access Token de producao (APP_USR-...) ou de teste (TEST-...).
#   Com um token TEST- o app usa automaticamente o sandbox_init_point.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
#
#   Assinatura secreta do webhook (Webhooks > Configurar notificacoes).
#   E um segredo por aplicacao e por ambiente — o de teste nao vale em producao.
# MERCADOPAGO_WEBHOOK_SECRET=...
#
# SITE_URL=https://r1kclub.com
# ALLOWED_ORIGINS=https://r1kclub.com,https://www.r1kclub.com
